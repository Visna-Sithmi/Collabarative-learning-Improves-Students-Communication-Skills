get_mode <- function(v) {
uniqv <- unique(v)
freq <- tabulate(match(v, uniqv))
modes <- uniqv[freq == max(freq)]
return(modes)
}
cat("\nMode of Years (X3):", get_mode(mlb$X3), "\n")
find_outliers <- function(v) {
Q1 <- quantile(v, 0.25)
Q3 <- quantile(v, 0.75)
IQR_value <- IQR(v)
lower_bound <- Q1 - 1.5 * IQR_value
upper_bound <- Q3 + 1.5 * IQR_value
outliers <- v[v < lower_bound | v > upper_bound]
return(outliers)
}
for (var in variables) {
cat("\nOutliers for", var, ":", find_outliers(mlb[[var]]), "\n")
}
